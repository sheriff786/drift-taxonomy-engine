# Drift Taxonomy Engine - Environment Variables
# Copy to .env and fill in values

# API Configuration
DTE_API_HOST=localhost
DTE_API_PORT=8000
DTE_API_WORKERS=4

# MLflow
DTE_MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
DTE_MLFLOW_EXPERIMENT_NAME=drift-taxonomy-engine

# Drift Thresholds (override defaults)
# DTE_KS_SIGNIFICANCE_LEVEL=0.001
# DTE_COHENS_D_THRESHOLD=0.5
# DTE_PERFORMANCE_DECAY_THRESHOLD=0.1

# Monitoring
DTE_PROMETHEUS_PORT=9090
